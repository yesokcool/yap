<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPhone and iPad screen sharing: the app and its broadcast extension
	     share this App Group's container, where the pictures cross over a
	     Unix socket (YapScreenLink). YAP_APP_GROUP is group.<bundle id>. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(YAP_APP_GROUP)</string>
	</array>
</dict>
</plist>
